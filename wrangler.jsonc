{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tag-loom",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tag-loom",
      "database_id": "58a9be7a-8b0d-4468-9b5d-4adca741a450",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
